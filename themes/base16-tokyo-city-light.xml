<frescobaldi-theme name="#Tokyo City Light">
  <!--
  Created by base16-frescobaldi
  Author: #Michaël Ball
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#343B59" />
    <background color="#FBFBFD" />
    <selectiontext color="#1D252C" />
    <selectionbackground color="#9699A3" />
    <current color="#F6F6F8" />
    <mark color="#EDEFF6" />
    <error color="#F6F6F8" />
    <search color="#" />
    <match color="#4C505E" />
    <paper color="#171D23" />
    <musichighlight color="#9699A3" />
  </baseColors>
  <defaultStyles>
    <string textColor="#8C4351" />
    <escape textColor="#965027" />
    <comment italic="True" textColor="#9699A3" />
    <value textColor="#4C505E" />
    <variable textColor="#485E30" />
    <keyword bold="True" />
    <function bold="True" textColor="#34548A" />
    <error textColor="#5A4A78" underline="True" underlineColor="#5A4A78" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#965027" />
      <dynamic bold="True" textColor="#34548A" />
      <articulation bold="True" textColor="#965027" />
      <fingering textColor="#485E30" />
      <stringnumber textColor="#965027" />
      <slur bold="True" />
      <markup bold="False" textColor="#4C505E" />
      <lyricmode textColor="#34548A" />
      <lyrictext textColor="#343B59" />
      <context bold="True" />
      <grob textColor="#343B59" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
