<frescobaldi-theme name="#PaperColor Light">
  <!--
  Created by base16-frescobaldi
  Author: #Jon Leopard (http://github.com/jonleopard), Tinted Theming (https://github.com/tinted-theming), based on PaperColor Theme (https://github.com/NLKNguyen/papercolor-theme)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#5E5E5E" />
    <background color="#EEEEEE" />
    <selectiontext color="#525252" />
    <selectionbackground color="#858585" />
    <current color="#C4C4C4" />
    <mark color="#9E9E9E" />
    <error color="#C4C4C4" />
    <search color="#" />
    <match color="#6B6B6B" />
    <paper color="#444444" />
    <musichighlight color="#858585" />
  </baseColors>
  <defaultStyles>
    <string textColor="#D70000" />
    <escape textColor="#D75F00" />
    <comment italic="True" textColor="#858585" />
    <value textColor="#D75F00" />
    <variable textColor="#008700" />
    <keyword bold="True" />
    <function bold="True" textColor="#005F87" />
    <error textColor="#8700AF" underline="True" underlineColor="#8700AF" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#D75F00" />
      <dynamic bold="True" textColor="#005F87" />
      <articulation bold="True" textColor="#D75F00" />
      <fingering textColor="#008700" />
      <stringnumber textColor="#D75F00" />
      <slur bold="True" />
      <markup bold="False" textColor="#D75F00" />
      <lyricmode textColor="#005F87" />
      <lyrictext textColor="#5E5E5E" />
      <context bold="True" />
      <grob textColor="#5E5E5E" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
