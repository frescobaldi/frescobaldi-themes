<frescobaldi-theme name="#boo-shnickle-light">
  <!--
  Created by base16-frescobaldi
  Author: #boo-shnickle (@boo_shnickle)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#5B5B49" />
    <background color="#FFFFCC" />
    <selectiontext color="#3A3A2E" />
    <selectionbackground color="#9C9C7D" />
    <current color="#DEDEB2" />
    <mark color="#BDBD97" />
    <error color="#DEDEB2" />
    <search color="#" />
    <match color="#7C7C63" />
    <paper color="#191914" />
    <musichighlight color="#9C9C7D" />
  </baseColors>
  <defaultStyles>
    <string textColor="#FFBFA5" />
    <escape textColor="#FFDC99" />
    <comment italic="True" textColor="#9C9C7D" />
    <value textColor="#FFF299" />
    <variable textColor="#E7FF99" />
    <keyword bold="True" />
    <function bold="True" textColor="#BFBFD9" />
    <error textColor="#F2BFD9" underline="True" underlineColor="#F2BFD9" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#FFDC99" />
      <dynamic bold="True" textColor="#BFBFD9" />
      <articulation bold="True" textColor="#FFDC99" />
      <fingering textColor="#E7FF99" />
      <stringnumber textColor="#FFDC99" />
      <slur bold="True" />
      <markup bold="False" textColor="#FFF299" />
      <lyricmode textColor="#BFBFD9" />
      <lyrictext textColor="#5B5B49" />
      <context bold="True" />
      <grob textColor="#5B5B49" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
