<frescobaldi-theme name="#Edge Light">
  <!--
  Created by base16-frescobaldi
  Author: #cjayross (https://github.com/cjayross), Tinted Theming (https://github.com/tinted-theming)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#474752" />
    <background color="#FAFAFA" />
    <selectiontext color="#3A3A46" />
    <selectionbackground color="#9197A1" />
    <current color="#E3E5E8" />
    <mark color="#ACB1B9" />
    <error color="#E3E5E8" />
    <search color="#" />
    <match color="#5E646F" />
    <paper color="#2E2E38" />
    <musichighlight color="#9197A1" />
  </baseColors>
  <defaultStyles>
    <string textColor="#DB7070" />
    <escape textColor="#EBA31A" />
    <comment italic="True" textColor="#9197A1" />
    <value textColor="#EBCC1A" />
    <variable textColor="#7C9F4B" />
    <keyword bold="True" />
    <function bold="True" textColor="#6587BF" />
    <error textColor="#B870CE" underline="True" underlineColor="#B870CE" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#EBA31A" />
      <dynamic bold="True" textColor="#6587BF" />
      <articulation bold="True" textColor="#EBA31A" />
      <fingering textColor="#7C9F4B" />
      <stringnumber textColor="#EBA31A" />
      <slur bold="True" />
      <markup bold="False" textColor="#EBCC1A" />
      <lyricmode textColor="#6587BF" />
      <lyrictext textColor="#474752" />
      <context bold="True" />
      <grob textColor="#474752" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
