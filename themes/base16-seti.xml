<frescobaldi-theme name="#Seti UI">
  <!--
  Created by base16-frescobaldi
  Author: #
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#D6D6D6" />
    <background color="#151718" />
    <selectiontext color="#EEEEEE" />
    <selectionbackground color="#41535B" />
    <current color="#282A2B" />
    <mark color="#3B758C" />
    <error color="#282A2B" />
    <search color="#" />
    <match color="#43A5D5" />
    <paper color="#FFFFFF" />
    <musichighlight color="#41535B" />
  </baseColors>
  <defaultStyles>
    <string textColor="#CD3F45" />
    <escape textColor="#DB7B55" />
    <comment italic="True" textColor="#41535B" />
    <value textColor="#E6CD69" />
    <variable textColor="#9FCA56" />
    <keyword bold="True" />
    <function bold="True" textColor="#55B5DB" />
    <error textColor="#A074C4" underline="True" underlineColor="#A074C4" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#DB7B55" />
      <dynamic bold="True" textColor="#55B5DB" />
      <articulation bold="True" textColor="#DB7B55" />
      <fingering textColor="#9FCA56" />
      <stringnumber textColor="#DB7B55" />
      <slur bold="True" />
      <markup bold="False" textColor="#E6CD69" />
      <lyricmode textColor="#55B5DB" />
      <lyrictext textColor="#D6D6D6" />
      <context bold="True" />
      <grob textColor="#D6D6D6" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
