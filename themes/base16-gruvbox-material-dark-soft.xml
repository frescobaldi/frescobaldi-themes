<frescobaldi-theme name="#Gruvbox Material Dark, Soft">
  <!--
  Created by base16-frescobaldi
  Author: #Mayush Kumar (https://github.com/MayushKumar), sainnhe (https://github.com/sainnhe/gruvbox-material-vscode)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#DDC7A1" />
    <background color="#32302F" />
    <selectiontext color="#EBDBB2" />
    <selectionbackground color="#7C6F64" />
    <current color="#3C3836" />
    <mark color="#5A524C" />
    <error color="#3C3836" />
    <search color="#" />
    <match color="#BDAE93" />
    <paper color="#FBF1C7" />
    <musichighlight color="#7C6F64" />
  </baseColors>
  <defaultStyles>
    <string textColor="#EA6962" />
    <escape textColor="#E78A4E" />
    <comment italic="True" textColor="#7C6F64" />
    <value textColor="#D8A657" />
    <variable textColor="#A9B665" />
    <keyword bold="True" />
    <function bold="True" textColor="#7DAEA3" />
    <error textColor="#D3869B" underline="True" underlineColor="#D3869B" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#E78A4E" />
      <dynamic bold="True" textColor="#7DAEA3" />
      <articulation bold="True" textColor="#E78A4E" />
      <fingering textColor="#A9B665" />
      <stringnumber textColor="#E78A4E" />
      <slur bold="True" />
      <markup bold="False" textColor="#D8A657" />
      <lyricmode textColor="#7DAEA3" />
      <lyrictext textColor="#DDC7A1" />
      <context bold="True" />
      <grob textColor="#DDC7A1" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
