<frescobaldi-theme name="#Heetch Light">
  <!--
  Created by base16-frescobaldi
  Author: #Geoffrey Teale (tealeg@gmail.com), Tinted Theming (https://github.com/tinted-theming)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#5A496E" />
    <background color="#FEFFFF" />
    <selectiontext color="#392551" />
    <selectionbackground color="#9C92A8" />
    <current color="#DEDAE2" />
    <mark color="#BDB6C5" />
    <error color="#DEDAE2" />
    <search color="#" />
    <match color="#7B6D8B" />
    <paper color="#190134" />
    <musichighlight color="#9C92A8" />
  </baseColors>
  <defaultStyles>
    <string textColor="#F80059" />
    <escape textColor="#BD0152" />
    <comment italic="True" textColor="#9C92A8" />
    <value textColor="#BD9701" />
    <variable textColor="#5BB66A" />
    <keyword bold="True" />
    <function bold="True" textColor="#5BA2B6" />
    <error textColor="#8F6C97" underline="True" underlineColor="#8F6C97" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#BD0152" />
      <dynamic bold="True" textColor="#5BA2B6" />
      <articulation bold="True" textColor="#BD0152" />
      <fingering textColor="#5BB66A" />
      <stringnumber textColor="#BD0152" />
      <slur bold="True" />
      <markup bold="False" textColor="#BD9701" />
      <lyricmode textColor="#5BA2B6" />
      <lyrictext textColor="#5A496E" />
      <context bold="True" />
      <grob textColor="#5A496E" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
