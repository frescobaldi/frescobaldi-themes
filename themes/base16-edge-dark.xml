<frescobaldi-theme name="#Edge Dark">
  <!--
  Created by base16-frescobaldi
  Author: #cjayross (https://github.com/cjayross), Tinted Theming (https://github.com/tinted-theming)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#AFB2B5" />
    <background color="#262729" />
    <selectiontext color="#CACCCE" />
    <selectionbackground color="#4A4C4F" />
    <current color="#313235" />
    <mark color="#3D3F42" />
    <error color="#313235" />
    <search color="#" />
    <match color="#95989D" />
    <paper color="#E4E5E6" />
    <musichighlight color="#4A4C4F" />
  </baseColors>
  <defaultStyles>
    <string textColor="#E77171" />
    <escape textColor="#EBA31A" />
    <comment italic="True" textColor="#4A4C4F" />
    <value textColor="#DBB774" />
    <variable textColor="#A1BF78" />
    <keyword bold="True" />
    <function bold="True" textColor="#73B3E7" />
    <error textColor="#D390E7" underline="True" underlineColor="#D390E7" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#EBA31A" />
      <dynamic bold="True" textColor="#73B3E7" />
      <articulation bold="True" textColor="#EBA31A" />
      <fingering textColor="#A1BF78" />
      <stringnumber textColor="#EBA31A" />
      <slur bold="True" />
      <markup bold="False" textColor="#DBB774" />
      <lyricmode textColor="#73B3E7" />
      <lyrictext textColor="#AFB2B5" />
      <context bold="True" />
      <grob textColor="#AFB2B5" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
