<frescobaldi-theme name="#Eva Dim">
  <!--
  Created by base16-frescobaldi
  Author: #kjakapat (https://github.com/kjakapat)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#9FA2A6" />
    <background color="#2A3B4D" />
    <selectiontext color="#D6D7D9" />
    <selectionbackground color="#55799C" />
    <current color="#3D566F" />
    <mark color="#4B6988" />
    <error color="#3D566F" />
    <search color="#" />
    <match color="#7E90A3" />
    <paper color="#FFFFFF" />
    <musichighlight color="#55799C" />
  </baseColors>
  <defaultStyles>
    <string textColor="#C4676C" />
    <escape textColor="#FF9966" />
    <comment italic="True" textColor="#55799C" />
    <value textColor="#CFD05D" />
    <variable textColor="#5DE561" />
    <keyword bold="True" />
    <function bold="True" textColor="#1AE1DC" />
    <error textColor="#9C6CD3" underline="True" underlineColor="#9C6CD3" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#FF9966" />
      <dynamic bold="True" textColor="#1AE1DC" />
      <articulation bold="True" textColor="#FF9966" />
      <fingering textColor="#5DE561" />
      <stringnumber textColor="#FF9966" />
      <slur bold="True" />
      <markup bold="False" textColor="#CFD05D" />
      <lyricmode textColor="#1AE1DC" />
      <lyrictext textColor="#9FA2A6" />
      <context bold="True" />
      <grob textColor="#9FA2A6" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
