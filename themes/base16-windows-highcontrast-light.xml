<frescobaldi-theme name="#Windows High Contrast Light">
  <!--
  Created by base16-frescobaldi
  Author: #Fergus Collins (https://github.com/ferguscollins)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#545454" />
    <background color="#FCFCFC" />
    <selectiontext color="#2A2A2A" />
    <selectionbackground color="#C0C0C0" />
    <current color="#E8E8E8" />
    <mark color="#D4D4D4" />
    <error color="#E8E8E8" />
    <search color="#" />
    <match color="#7E7E7E" />
    <paper color="#000000" />
    <musichighlight color="#C0C0C0" />
  </baseColors>
  <defaultStyles>
    <string textColor="#800000" />
    <escape textColor="#FCFC54" />
    <comment italic="True" textColor="#C0C0C0" />
    <value textColor="#808000" />
    <variable textColor="#008000" />
    <keyword bold="True" />
    <function bold="True" textColor="#000080" />
    <error textColor="#800080" underline="True" underlineColor="#800080" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#FCFC54" />
      <dynamic bold="True" textColor="#000080" />
      <articulation bold="True" textColor="#FCFC54" />
      <fingering textColor="#008000" />
      <stringnumber textColor="#FCFC54" />
      <slur bold="True" />
      <markup bold="False" textColor="#808000" />
      <lyricmode textColor="#000080" />
      <lyrictext textColor="#545454" />
      <context bold="True" />
      <grob textColor="#545454" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
