<frescobaldi-theme name="#Chinoiserie Midnight">
  <!--
  Created by base16-frescobaldi
  Author: #Di Wang (https://cs.cmu.edu/~diw3)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#C4CBCF" />
    <background color="#1D1D1D" />
    <selectiontext color="#EEE7F2" />
    <selectionbackground color="#918072" />
    <current color="#282828" />
    <mark color="#373737" />
    <error color="#282828" />
    <search color="#" />
    <match color="#BDAEAD" />
    <paper color="#FFFEF9" />
    <musichighlight color="#918072" />
  </baseColors>
  <defaultStyles>
    <string textColor="#ED5A56" />
    <escape textColor="#FC8C23" />
    <comment italic="True" textColor="#918072" />
    <value textColor="#FBB957" />
    <variable textColor="#AEB831" />
    <keyword bold="True" />
    <function bold="True" textColor="#81A2A2" />
    <error textColor="#CF8997" underline="True" underlineColor="#CF8997" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#FC8C23" />
      <dynamic bold="True" textColor="#81A2A2" />
      <articulation bold="True" textColor="#FC8C23" />
      <fingering textColor="#AEB831" />
      <stringnumber textColor="#FC8C23" />
      <slur bold="True" />
      <markup bold="False" textColor="#FBB957" />
      <lyricmode textColor="#81A2A2" />
      <lyrictext textColor="#C4CBCF" />
      <context bold="True" />
      <grob textColor="#C4CBCF" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
