<frescobaldi-theme name="#Penumbra Dark">
  <!--
  Created by base16-frescobaldi
  Author: #Zachary Weiss (https://github.com/zacharyweiss)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#BEBEBE" />
    <background color="#24272B" />
    <selectiontext color="#FFF7ED" />
    <selectionbackground color="#636363" />
    <current color="#303338" />
    <mark color="#3E4044" />
    <error color="#303338" />
    <search color="#" />
    <match color="#8F8F8F" />
    <paper color="#FFFDFB" />
    <musichighlight color="#636363" />
  </baseColors>
  <defaultStyles>
    <string textColor="#CA736C" />
    <escape textColor="#BA823A" />
    <comment italic="True" textColor="#636363" />
    <value textColor="#8D9741" />
    <variable textColor="#47A477" />
    <keyword bold="True" />
    <function bold="True" textColor="#5794D0" />
    <error textColor="#9481CC" underline="True" underlineColor="#9481CC" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#BA823A" />
      <dynamic bold="True" textColor="#5794D0" />
      <articulation bold="True" textColor="#BA823A" />
      <fingering textColor="#47A477" />
      <stringnumber textColor="#BA823A" />
      <slur bold="True" />
      <markup bold="False" textColor="#8D9741" />
      <lyricmode textColor="#5794D0" />
      <lyrictext textColor="#BEBEBE" />
      <context bold="True" />
      <grob textColor="#BEBEBE" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
