<frescobaldi-theme name="#Unikitty Dark">
  <!--
  Created by base16-frescobaldi
  Author: #Josh W Lewis (@joshwlewis)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#BCBABE" />
    <background color="#2E2A31" />
    <selectiontext color="#D8D7DA" />
    <selectionbackground color="#838085" />
    <current color="#4A464D" />
    <mark color="#666369" />
    <error color="#4A464D" />
    <search color="#" />
    <match color="#9F9DA2" />
    <paper color="#F5F4F7" />
    <musichighlight color="#838085" />
  </baseColors>
  <defaultStyles>
    <string textColor="#D8137F" />
    <escape textColor="#D65407" />
    <comment italic="True" textColor="#838085" />
    <value textColor="#DC8A0E" />
    <variable textColor="#17AD98" />
    <keyword bold="True" />
    <function bold="True" textColor="#796AF5" />
    <error textColor="#BB60EA" underline="True" underlineColor="#BB60EA" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#D65407" />
      <dynamic bold="True" textColor="#796AF5" />
      <articulation bold="True" textColor="#D65407" />
      <fingering textColor="#17AD98" />
      <stringnumber textColor="#D65407" />
      <slur bold="True" />
      <markup bold="False" textColor="#DC8A0E" />
      <lyricmode textColor="#796AF5" />
      <lyrictext textColor="#BCBABE" />
      <context bold="True" />
      <grob textColor="#BCBABE" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
