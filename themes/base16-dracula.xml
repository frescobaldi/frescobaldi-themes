<frescobaldi-theme name="#Dracula">
  <!--
  Created by base16-frescobaldi
  Author: #clach04 (https://github.com/clach04)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#F8F8F2" />
    <background color="#282A36" />
    <selectiontext color="#F8F8F2" />
    <selectionbackground color="#6272A4" />
    <current color="#21222C" />
    <mark color="#44475A" />
    <error color="#21222C" />
    <search color="#" />
    <match color="#9EA8C7" />
    <paper color="#FFFFFF" />
    <musichighlight color="#6272A4" />
  </baseColors>
  <defaultStyles>
    <string textColor="#FF5555" />
    <escape textColor="#FFB86C" />
    <comment italic="True" textColor="#6272A4" />
    <value textColor="#F1FA8C" />
    <variable textColor="#50FA7B" />
    <keyword bold="True" />
    <function bold="True" textColor="#BD93F9" />
    <error textColor="#FF79C6" underline="True" underlineColor="#FF79C6" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#FFB86C" />
      <dynamic bold="True" textColor="#BD93F9" />
      <articulation bold="True" textColor="#FFB86C" />
      <fingering textColor="#50FA7B" />
      <stringnumber textColor="#FFB86C" />
      <slur bold="True" />
      <markup bold="False" textColor="#F1FA8C" />
      <lyricmode textColor="#BD93F9" />
      <lyrictext textColor="#F8F8F2" />
      <context bold="True" />
      <grob textColor="#F8F8F2" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
