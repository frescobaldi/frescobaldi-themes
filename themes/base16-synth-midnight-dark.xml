<frescobaldi-theme name="#Synth Midnight Terminal Dark">
  <!--
  Created by base16-frescobaldi
  Author: #Michaël Ball (http://github.com/michael-ball/)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#C1C3C4" />
    <background color="#050608" />
    <selectiontext color="#CFD1D2" />
    <selectionbackground color="#474849" />
    <current color="#1A1B1C" />
    <mark color="#28292A" />
    <error color="#1A1B1C" />
    <search color="#" />
    <match color="#A3A5A6" />
    <paper color="#DDDFE0" />
    <musichighlight color="#474849" />
  </baseColors>
  <defaultStyles>
    <string textColor="#B53B50" />
    <escape textColor="#EA770D" />
    <comment italic="True" textColor="#474849" />
    <value textColor="#C9D364" />
    <variable textColor="#06EA61" />
    <keyword bold="True" />
    <function bold="True" textColor="#03AEFF" />
    <error textColor="#EA5CE2" underline="True" underlineColor="#EA5CE2" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#EA770D" />
      <dynamic bold="True" textColor="#03AEFF" />
      <articulation bold="True" textColor="#EA770D" />
      <fingering textColor="#06EA61" />
      <stringnumber textColor="#EA770D" />
      <slur bold="True" />
      <markup bold="False" textColor="#C9D364" />
      <lyricmode textColor="#03AEFF" />
      <lyrictext textColor="#C1C3C4" />
      <context bold="True" />
      <grob textColor="#C1C3C4" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
