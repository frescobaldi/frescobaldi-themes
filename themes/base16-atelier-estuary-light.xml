<frescobaldi-theme name="#Atelier Estuary Light">
  <!--
  Created by base16-frescobaldi
  Author: #Bram de Haan (http://atelierbramdehaan.nl)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#5F5E4E" />
    <background color="#F4F3EC" />
    <selectiontext color="#302F27" />
    <selectionbackground color="#878573" />
    <current color="#E7E6DF" />
    <mark color="#929181" />
    <error color="#E7E6DF" />
    <search color="#" />
    <match color="#6C6B5A" />
    <paper color="#22221B" />
    <musichighlight color="#878573" />
  </baseColors>
  <defaultStyles>
    <string textColor="#BA6236" />
    <escape textColor="#AE7313" />
    <comment italic="True" textColor="#878573" />
    <value textColor="#A5980D" />
    <variable textColor="#7D9726" />
    <keyword bold="True" />
    <function bold="True" textColor="#36A166" />
    <error textColor="#5F9182" underline="True" underlineColor="#5F9182" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#AE7313" />
      <dynamic bold="True" textColor="#36A166" />
      <articulation bold="True" textColor="#AE7313" />
      <fingering textColor="#7D9726" />
      <stringnumber textColor="#AE7313" />
      <slur bold="True" />
      <markup bold="False" textColor="#A5980D" />
      <lyricmode textColor="#36A166" />
      <lyrictext textColor="#5F5E4E" />
      <context bold="True" />
      <grob textColor="#5F5E4E" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
