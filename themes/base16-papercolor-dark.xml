<frescobaldi-theme name="#PaperColor Dark">
  <!--
  Created by base16-frescobaldi
  Author: #Jon Leopard (http://github.com/jonleopard), Tinted Theming (https://github.com/tinted-theming), based on PaperColor Theme (https://github.com/NLKNguyen/papercolor-theme)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#9E9E9E" />
    <background color="#1C1C1C" />
    <selectiontext color="#B8B8B8" />
    <selectionbackground color="#585858" />
    <current color="#363636" />
    <mark color="#424242" />
    <error color="#363636" />
    <search color="#" />
    <match color="#808080" />
    <paper color="#D0D0D0" />
    <musichighlight color="#585858" />
  </baseColors>
  <defaultStyles>
    <string textColor="#FF5FAF" />
    <escape textColor="#D7AF5F" />
    <comment italic="True" textColor="#585858" />
    <value textColor="#FFAF00" />
    <variable textColor="#5FAF5F" />
    <keyword bold="True" />
    <function bold="True" textColor="#5FAFD7" />
    <error textColor="#AF87D7" underline="True" underlineColor="#AF87D7" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#D7AF5F" />
      <dynamic bold="True" textColor="#5FAFD7" />
      <articulation bold="True" textColor="#D7AF5F" />
      <fingering textColor="#5FAF5F" />
      <stringnumber textColor="#D7AF5F" />
      <slur bold="True" />
      <markup bold="False" textColor="#FFAF00" />
      <lyricmode textColor="#5FAFD7" />
      <lyrictext textColor="#9E9E9E" />
      <context bold="True" />
      <grob textColor="#9E9E9E" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
