<frescobaldi-theme name="#Github Dark Colorblind">
  <!--
  Created by base16-frescobaldi
  Author: #Tinted Theming (https://github.com/tinted-theming)
-->
  <font fontFamily="monospace" fontSize="10.0" />
  <baseColors>
    <text color="#C9D1D9" />
    <background color="#0D1117" />
    <selectiontext color="#F0F6FC" />
    <selectionbackground color="#6E7681" />
    <current color="#161B22" />
    <mark color="#484F58" />
    <error color="#161B22" />
    <search color="#" />
    <match color="#8B949E" />
    <paper color="#FFFFFF" />
    <musichighlight color="#6E7681" />
  </baseColors>
  <defaultStyles>
    <string textColor="#FDAC54" />
    <escape textColor="#79C0FF" />
    <comment italic="True" textColor="#6E7681" />
    <value textColor="#BB8009" />
    <variable textColor="#A5D6FF" />
    <keyword bold="True" />
    <function bold="True" textColor="#D2A8FF" />
    <error textColor="#EC8E2C" underline="True" underlineColor="#EC8E2C" />
  </defaultStyles>
  <allStyles>
    <lilypond>
      <duration textColor="#79C0FF" />
      <dynamic bold="True" textColor="#D2A8FF" />
      <articulation bold="True" textColor="#79C0FF" />
      <fingering textColor="#A5D6FF" />
      <stringnumber textColor="#79C0FF" />
      <slur bold="True" />
      <markup bold="False" textColor="#BB8009" />
      <lyricmode textColor="#D2A8FF" />
      <lyrictext textColor="#C9D1D9" />
      <context bold="True" />
      <grob textColor="#C9D1D9" />
    </lilypond>
  </allStyles>
</frescobaldi-theme>
